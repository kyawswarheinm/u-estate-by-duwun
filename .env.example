# Copy to .env.local and fill in. Never commit real keys. Every partner is optional:
# without a key the app shows a clearly labelled fallback (see /partners).

# --- Supabase (real-time database, auth, storage). Setup: docs/DATABASE.md §4 ---
# Public by design (protected by RLS):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Never prefix with NEXT_PUBLIC_, never commit, never paste into chat or PRs:
SUPABASE_SERVICE_ROLE_KEY=
# Explicitly use the local JSON prototype even when Supabase is configured:
DEMO_OFFLINE=false

# --- Claude (deed check, explanations, chat, search parsing) ---
ANTHROPIC_API_KEY=
# Optional: override the Claude model (default claude-opus-5-5)
CLAUDE_MODEL=

# --- Gemini (DEVELOPMENT ONLY: chat fallback when ANTHROPIC_API_KEY is empty, D-43) ---
# Leave these empty on the demo deployment so the chat always runs on Claude.
GEMINI_API_KEY=
GEMINI_MODEL=

# --- ElevenLabs (E1 voice, E2 voice search, E3 live voice agent) ---
# Key from the Creator-plan coupon (Discord #coupon-codes). Server-side only.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Eleven v3 speaks Thai (Multilingual v2 / Flash v2.5 do not)
ELEVENLABS_MODEL_ID=eleven_v3
# Scribe speech-to-text model
ELEVENLABS_STT_MODEL=scribe_v2
# Agent ID printed by `node scripts/create-voice-agent.mjs` (or copied from the ElevenLabs dashboard)
ELEVENLABS_AGENT_ID=

# --- Tokenomist (T1 crypto-deposit check) ---
# API plan with forward unlock data (the free trial only returns past unlocks). Without it: SAMPLE tokens.
TOKENOMIST_API_KEY=

# --- Avalanche (A1 ledger fingerprint on Fuji testnet) ---
# A NEW throwaway testnet wallet only. Never a wallet that holds real funds. Fund it from the Fuji faucet.
AVALANCHE_PRIVATE_KEY=
# Optional: defaults to the public Fuji RPC https://api.avax-test.network/ext/bc/C/rpc
AVALANCHE_RPC_URL=

# --- Demo accounts (sign in / sign up) ---
# Set to false to hide the one-click demo personas on /signin.
DEMO_MODE=true
# Sign-up accepts any made-up email (e.g. anythings@example.com); real inboxes such as gmail.com are refused.
# Configured Supabase owns passwords and sessions; offline JSON uses scrypt hashes.
# Reserved example.com/org/net signups use server-side creation only when both app and DB demo mode are enabled.
# Local test accounts (if any) are listed in .data/qa-accounts.local.txt, which is git-ignored. Never put passwords here.
