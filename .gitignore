# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local demo data store (password hashes, sessions, QA notes) - never commit
/.data
!.env.example

# secrets and local-only files (also enforced by scripts/check-secrets.mjs)
*.key
*.p12
*.pfx
*.local.txt
*.local.md
*.local.json
.claude/settings.local.json

# Supabase CLI local state
supabase/.temp/
supabase/.branches/

# render / scratch output
/tmp/
